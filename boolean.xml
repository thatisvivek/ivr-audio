<meta name="swirec_max_speech_duration" content="7000" />
<meta name="incompletetimeout" content="500"/>
 <rule id="ROOT" scope="public">
    <one-of>
      <item tag="SWI_meaning=true">yes</item>
      <item tag="SWI_meaning=true">correct</item>
      <item tag="SWI_meaning=false">no</item>
      <item tag="SWI_meaning=false">wrong</item>
    </one-of>
 </rule>
</grammar>
